# Docker 镜像，可替换为指定版本标签或镜像摘要
CLOUDSEED_IMAGE=ghcr.io/haoch1/cloudseed:latest
# Docker Compose 默认监听本机，可通过 HTTPS 反向代理访问
BIND_ADDRESS=127.0.0.1
APP_PORT=3180
# 设置为实际面板地址后，后端会校验请求来源
PUBLIC_URL=
# 仅在可信反向代理之后启用
TRUST_PROXY=false
# 首次启动时创建管理员，密码留空时自动生成并显示在启动日志中
CLOUDSEED_ADMIN_USERNAME=admin
CLOUDSEED_ADMIN_PASSWORD=
